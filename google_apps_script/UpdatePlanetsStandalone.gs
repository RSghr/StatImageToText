function updatePlanets() {
  var form = FormApp.openById(FORM_ID);
  var item = form.getItems().filter(function (it) {
    var t = it.getType();
    return (t === FormApp.ItemType.LIST || t === FormApp.ItemType.MULTIPLE_CHOICE) &&
           it.getTitle().toLowerCase().indexOf(QUESTION) !== -1;
  })[0];
  if (!item) throw new Error('No Dropdown / Multiple choice question with "' + QUESTION + '" in its title.');

  var seen = {}, names = [];
  PLANETS.forEach(function (n) {
    n = String(n).trim(); var k = n.toLowerCase();
    if (n && !seen[k] && k !== 'other') { seen[k] = true; names.push(n); }
  });
  names.sort(function (a, b) { return a.localeCompare(b); });

  var isList = item.getType() === FormApp.ItemType.LIST;
  var q = isList ? item.asListItem() : item.asMultipleChoiceItem();
  var before = q.getChoices().map(function (c) { return c.getValue(); });
  var hadOther = before.some(function (c) { return c.toLowerCase() === 'other'; });
  if (isList) q.setChoiceValues(hadOther ? names.concat(['Other']) : names);
  else { q.setChoiceValues(names); if (hadOther || q.hasOtherOption()) q.showOtherOption(true); }

  var added = names.filter(function (n) { return before.indexOf(n) === -1; });
  var removed = before.filter(function (n) { return n.toLowerCase() !== 'other' && names.indexOf(n) === -1; });
  Logger.log('Question: "' + item.getTitle() + '" now has ' + names.length + ' planets.');
  Logger.log('Added (' + added.length + '): ' + (added.join(', ') || '-'));
  Logger.log('Removed (' + removed.length + '): ' + (removed.join(', ') || '-'));
}
